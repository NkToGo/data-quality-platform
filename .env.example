# Copy this file to .env and replace the password before starting PostgreSQL.
POSTGRES_HOST=localhost
POSTGRES_DB=data_quality
POSTGRES_USER=data_quality
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# The request limit includes multipart headers and must exceed the file limit.
SOURCE_FILE_MAX_SIZE=10MB
SOURCE_FILE_MAX_REQUEST_SIZE=11MB
